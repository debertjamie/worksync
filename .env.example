# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Firebase web (client) config ---
# Exposed to the browser (NEXT_PUBLIC_*). From Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin (server-only) config ---
# From a service account JSON. Keep these unprefixed so they never reach the browser.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Double-quoted, single line, with literal \n for newlines.
FIREBASE_PRIVATE_KEY=""

# --- Supabase Postgres (server-only) ---
# Pooled connection (PgBouncer, port 6543) used by the app at runtime.
DATABASE_URL=""
# Direct connection (port 5432) used by Prisma for migrations.
DIRECT_URL=""
